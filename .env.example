# Copy to .env (which is gitignored) and change the secrets:  cp .env.example .env

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Signs the session cookie (JWT). Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Where the browser reaches the frontend; used to build links in emails.
APP_BASE_URL=http://localhost:5173

# SMTP: Mailpit in development (plain SMTP, no TLS, no auth).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mailpit Demo <no-reply@example.com>"
